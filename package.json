{
  "name": "student-portal",
  "version": "0.1.0",
  "description": "A small multi-tenant student portal REST API and web UI.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "express",
    "sqlite",
    "students",
    "portal",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
